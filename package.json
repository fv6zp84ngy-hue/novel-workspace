{
  "name": "novel-workspace",
  "private": true,
  "version": "0.4.1",
  "description": "Build-time-only CRDT bundle for the optional collaborative editor",
  "scripts": {
    "build:crdt": "esbuild src/yjs-entry.mjs --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=eof --outfile=vendor/yjs.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "yjs": "13.6.32"
  }
}
